{
  "name": "garuda-shabd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Garuda Shabd: a Hindi-English dictionary PWA with spelling-tolerant search",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "validate": "tsx scripts/validate-data.ts",
    "iast": "tsx scripts/iast.ts",
    "bench": "tsx scripts/bench-search.ts",
    "contrast": "tsx scripts/contrast.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run validate && npm run contrast"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-serif-devanagari": "^5.3.0",
    "@indic-transliteration/sanscript": "^1.3.3",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
